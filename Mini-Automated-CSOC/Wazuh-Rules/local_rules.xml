<!--
  Mini Automated CSOC
  Custom Wazuh Detection Rules

  Location:
  /var/ossec/etc/rules/local_rules.xml
-->

<!-- Ubuntu SSH Authentication & Brute-Force Detection -->
<group name="local,csoc,sshd,ssh,syslog,authentication_failed">

  <!-- Individual SSH authentication failure -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <description>CSOC: sshd authentication failed from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,csoc,</group>
  </rule>

  <!-- SSH brute-force detection -->
  <rule id="100101" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>CSOC ALERT: SSH brute force attack - 5+ failed attempts from $(srcip) within 120s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>brute_force,authentication_failures,csoc,</group>
  </rule>

</group>


<!-- Windows Brute-Force Detection -->
<group name="local,csoc,windows,">

  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>CSOC ALERT: Windows brute-force attack - multiple failed logons from $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,csoc,windows,</group>
  </rule>

</group>


<!-- Windows Firewall Detection -->
<group name="local,csoc,windows,firewall,network_scan,">

  <rule id="100200" level="5">
    <if_sid>4101</if_sid>
    <protocol>TCP</protocol>
    <description>CSOC: TCP connection blocked by Windows Firewall</description>
    <group>firewall_block,network_activity,csoc,windows,</group>
  </rule>

</group>


<!-- Suspicious PowerShell Detection -->
<group name="local,csoc,windows,powershell,">

  <rule id="100300" level="12">
    <if_sid>91809</if_sid>
    <description>CSOC ALERT: Suspicious PowerShell Base64 decoding detected</description>
    <mitre>
      <id>T1140</id>
    </mitre>
    <group>powershell,suspicious_activity,csoc,windows,</group>
  </rule>

</group>


<!-- Active Response Event Rules -->
<group name="local,csoc,active_response,ossec,">

  <!-- IP blocked -->
  <rule id="100600" level="10" overwrite="yes">
    <if_sid>651</if_sid>
    <description>CSOC ALERT: Attacker IP has been BLOCKED by firewall-drop for 120 seconds</description>
    <mitre>
      <id>T1562.004</id>
    </mitre>
    <group>active_response,firewall_drop,csoc,ossec,</group>
  </rule>

  <!-- IP automatically unblocked -->
  <rule id="100601" level="10" overwrite="yes">
    <if_sid>652</if_sid>
    <description>CSOC ALERT: Attacker IP has been UNBLOCKED by firewall-drop Active Response</description>
    <group>active_response,firewall_drop,csoc,ossec,</group>
  </rule>

</group>
